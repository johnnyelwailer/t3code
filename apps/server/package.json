{
  "name": "t3",
  "version": "0.0.35",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pingdotgg/t3code",
    "directory": "apps/server"
  },
  "bin": {
    "t3": "./dist/bin.mjs",
    "t3team": "./dist/t3team-bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "dev": "node --watch src/bin.ts",
    "dev:t3team": "node --watch src/t3team-bin.ts",
    "build:bundle": "vp pack && vp pack src/service-launcher.ts --out-dir dist --no-clean",
    "start": "node dist/bin.mjs",
    "start:t3team": "node dist/t3team-bin.mjs",
    "typecheck": "tsgo --noEmit",
    "test": "vp test run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.170",
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@ff-labs/fff-node": "0.9.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opencode-ai/sdk": "^1.3.15",
    "@pierre/diffs": "catalog:",
    "@silvia-odwyer/photon-node": "^0.3.4",
    "@t3team/pack-api": "workspace:*",
    "@t3team/packs": "workspace:*",
    "@t3team/sdk": "workspace:*",
    "@t3tools/integrations-atlassian": "workspace:*",
    "@t3tools/integrations-core": "workspace:*",
    "@t3tools/project-context": "workspace:*",
