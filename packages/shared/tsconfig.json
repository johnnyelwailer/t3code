{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": [
    // Browser voice UI modules (t3team-voiceInput*) that use browser globals (Date.now/setTimeout).
    // The Effect language-service rules that ban them (tsconfig.base.json)
    // target Effect code; each consuming app typechecks these files under its
    // own tsconfig (apps/web relaxes exactly these rules for browser
    // components). Pure modules (types.ts, autoSend.ts, waveform.ts) and the
    // presentational RecordingBar.tsx stay in Effect-lint scope.
    "src/t3team-voiceInputUi.tsx",
    "src/t3team-voiceInputUi/t3team-useVoiceInput.ts",
    // Same scope: the component render test imports the browser voice UI
    // modules above (excluded here) and uses react-dom/server.
    "src/t3team-voiceInputUi.test.ts",
    // recognition.ts uses setTimeout (language-switch delay) and is imported
    // by its own test — both stay out of Effect-lint scope for the same
    // reason; the tests still run under vitest.
    "src/t3team-voiceInputUi/t3team-recognition.ts",
    "src/t3team-voiceInputUi/t3team-recognition.test.ts",
    "src/t3team-voiceInputUi/t3team-recognitionLanguage.test.ts"
  ]
}
