{
  "compilerOptions": {
    "plugins": [
      {
        "name": "@effect/language-service",
        "namespaceImportPackages": ["@effect/platform-node", "effect"],
        "effectFn": ["span", "inferred-span", "suggested-span"],
        "diagnosticSeverity": {
          // t3team: upstream escalated these style rules to "error" in the 2026-10-29 sync. The fork's
          // t3team-* code (~650 sites in apps/server alone) predates them, so they stay "suggestion"
          // here until a follow-up fixes the sites; upstream code already satisfies them.
          "abortControllerInEffect": "suggestion",
          "runEffectInsideEffect": "suggestion",
          "flatMapConditionalToFilterOrFail": "suggestion",
          "catchConditionalRefailToCatchIf": "suggestion",
          "tryCatchInEffectGen": "suggestion",
          "schemaStructWithTag": "suggestion",
          "preferTypedSchemaDecoder": "suggestion",
          "catchUnfailableEffect": "suggestion",
          "raceFirstWithSleepToTimeout": "suggestion",
          "redundantMapError": "suggestion",
          "optionMatchToFromOption": "suggestion",
          "catchToIgnore": "suggestion",
          "unnecessaryEffectGen": "suggestion",
          "allOfMapToForEach": "suggestion",
          "catchToOrElseSucceed": "suggestion",
          "unnecessaryFailYieldableError": "suggestion",
          "preferSucceedSomeOrNone": "suggestion",
          "effectSucceedWithVoid": "suggestion",
          "provideLayerSucceedToProvideService": "suggestion",
          "flatMapIgnoredParamToAndThen": "suggestion",
          "mapSomeToAsSome": "suggestion",
          "unnecessaryPipeChain": "suggestion",
          "returnEffectInGen": "off",
          "effectFnOpportunity": "suggestion",
          "anyUnknownInErrorContext": "error",
          "unsafeEffectTypeAssertion": "error",
          "instanceOfSchema": "error",
          "deterministicKeys": "error",
          "strictEffectProvide": "off",
          // We use Effect's unstable modules (http, sql) on purpose. These rules
          // also make effect-tsgo 0.47+ report false TS2790 errors on `delete`.
          "unstableApiUsage": "off",
          "experimentalApiUsage": "off",
          "missingEffectServiceDependency": "error",
          "leakingRequirements": "error",
          "globalErrorInEffectCatch": "error",
          "globalErrorInEffectFailure": "error",
          "unknownInEffectCatch": "error",
          "strictBooleanExpressions": "off",
          "lazyEffect": "off",
          "globalJsonInEffect": "error",
          "schemaSyncInEffect": "error",
          "cryptoRandomUUID": "error",
          "cryptoRandomUUIDInEffect": "error",
          "nodeBuiltinImport": "error",
          "globalDate": "error",
          "globalDateInEffect": "error",
          "globalConsole": "error",
          "globalConsoleInEffect": "error",
          "globalRandom": "error",
          "globalRandomInEffect": "error",
          "globalTimers": "error",
          "globalTimersInEffect": "error",
          "globalFetch": "error",
          "globalFetchInEffect": "error",
          "acquireReleaseDisposable": "error",
          "catchAllTagDispatchToCatchTag": "error",
          "catchAllToMapError": "error",
          "catchChainToFirstSuccessOf": "error",
          "catchDieToOrDie": "error",
          "catchIfTagToCatchTag": "error",
          "catchRefailToTapError": "error",
          "catchTagToCatchReason": "error",
          "effectMapFlatten": "error",
          "effectMapVoid": "error",
          "effectSleepZeroToYieldNow": "error",
          "effectSucceedWithUndefined": "error",
          "errorPayloadShadowsName": "error",
          "failCauseToConstructor": "error",
          "flatMapIdentityToFlatten": "error",
          "flatMapToMap": "error",
          "flatMapToTap": "error",
          "manualMetricTapToTrack": "error",
          "mapConstToAs": "error",
          "mapSomeCatchNoSuchElement": "error",
          "matchBooleanToIsSuccess": "error",
          "matchEffectToMapBoth": "error",
          "matchEffectToMatch": "error",
          "matchToResultOrOption": "error",
          "multipleCatchTag": "error",
          "preferUnsafeConstructor": "error",
          "redundantOrDie": "error",
          "redundantSchemaTagIdentifier": "error",
          "resultMatchToFromResult": "error",
          "runOfExitToRunExit": "error",
          "suspendFailToFailSync": "error",
          "syncToSucceed": "error",
          "timeoutCatchTagToTimeoutOrElse": "error",
          "unnecessaryPipe": "error",
          "unnecessaryTypeofType": "error",
          "effectTryWithoutCatch": "error",
          "processEnvInEffect": "error",
          "preferSchemaTaggedError": "error",
          "extendsNativeError": "error",
          "schemaNumber": "off"
        },
        "overrides": [
          {
            "include": ["**/*.test.ts", "**/*.test.tsx"],
            "options": {
              "diagnosticSeverity": {
                "globalJsonInEffect": "off",
                "effectFnOpportunity": "off"
              }
            }
          },
          {
            "include": [
              "**/*.spec.ts",
              "**/*.spec.tsx",
              "**/*.testkit.ts",
              "**/*.testkit.tsx",
              "**/test/**/*",
              "**/tests/**/*",
              "**/testkit/**/*",
              "**/testing/**/*",
              "**/fixtures/**/*",
              "**/integration/**/*",
              "packages/provider-testing/**/*"
            ],
            "options": { "diagnosticSeverity": { "effectFnOpportunity": "off" } }
          },
          {
            // t3team: upstream added these rules as "error" in the 2026-11-10 sync; fork-owned code
            // predates them and stays at "suggestion" until a follow-up fixes the sites.
            "include": [
              "**/t3team-*",
              "**/t3team/**/*",
              "packages/runbook-*/**/*",
              "packages/integrations-*/**/*",
              "packages/project-*/**/*",
              "packages/agent-runner/**/*"
            ],
            "options": {
              "diagnosticSeverity": {
                "processEnvInEffect": "suggestion",
                "effectTryWithoutCatch": "suggestion",
                "preferSchemaTaggedError": "suggestion",
                "effectSucceedWithUndefined": "suggestion",
                "globalJsonInEffect": "suggestion",
                "extendsNativeError": "suggestion",
                "unnecessaryTypeofType": "suggestion",
                "effectSleepZeroToYieldNow": "suggestion",
                "catchRefailToTapError": "suggestion",
                "syncToSucceed": "suggestion",
                "flatMapToTap": "suggestion",
                "matchBooleanToIsSuccess": "suggestion",
                "mapConstToAs": "suggestion"
              }
            }
          },
          {
            // t3team: runbook packages typecheck with the Effect rules since the effect-tsgo switch.
            "include": ["packages/runbook-*/**/*"],
            "options": {
              "diagnosticSeverity": {
                "nodeBuiltinImport": "suggestion",
                "globalDate": "suggestion",
                "globalRandom": "suggestion"
              }
            }
          }
        ]
      }
    ]
  }
}
