{
  // The Effect language service config lives apart so apps/mobile can extend it with Expo's base.
  "extends": "./tsconfig.effect.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "useDefineForClassFields": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@t3code/distribution": ["./apps/server/src/t3team-distribution.ts"],
      "@t3team/sdk": ["./packages/t3team-sdk/src/t3team-sdk.index.ts"],
      "@t3team/sdk/groups": ["./packages/t3team-sdk/src/t3team-sdk.groups.ts"],
      "@t3team/sdk/tools/t3team": ["./packages/t3team-sdk/src/tools/t3team-sdk.t3team.ts"]
    }
  }
}
